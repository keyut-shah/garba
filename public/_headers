# Cloudflare Pages headers.
# `next build` with output:"export" writes the OG image as an extensionless
# file, so Pages would serve it as application/octet-stream and Twitter /
# WhatsApp would refuse to render the preview. Force the type.
/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=3600

# Content-hashed — safe to cache forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
