# Headers for Cloudflare static assets.
# These apply to asset responses only — never to anything worker/index.ts
# returns, so /api/* is unaffected by this file.
#
# `next build` with output:"export" writes the OG image as an extensionless
# file, so it would be served as application/octet-stream and Twitter /
# WhatsApp would refuse to render the preview. Force the type.
/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=3600

# Content-hashed — safe to cache forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The artwork is not content-hashed, so a day rather than a year: swapping it
# shouldn't leave anyone who has already visited staring at the old one.
/background.webp
  Cache-Control: public, max-age=86400
